# Supply an audited Bun image by digest, not a floating tag:
# docker build -f Dockerfile.sandbox --build-arg BUN_IMAGE=oven/bun@sha256:<digest> -t nano-agent-sandbox .
ARG BUN_IMAGE
FROM ${BUN_IMAGE}
USER root
RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update; apt-get install -y --no-install-recommends python3 python3-venv; rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache python3 py3-pip; \
    else \
      echo "Sandbox base image needs apt-get or apk to install Python" >&2; exit 1; \
    fi
WORKDIR /agent
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --ignore-scripts
COPY app/tools/ipython-requirements.txt ./app/tools/
RUN python3 -m venv /opt/nano-agent-ipython \
    && /opt/nano-agent-ipython/bin/pip install --no-cache-dir --only-binary=:all: \
      --require-hashes --no-deps --requirement app/tools/ipython-requirements.txt \
    && /opt/nano-agent-ipython/bin/python -c \
      'import sys, IPython; assert sys.version_info >= (3, 11), sys.version; assert IPython.__version__ == "9.17.1"'
COPY app/agent ./app/agent
COPY app/session ./app/session
COPY app/shared ./app/shared
COPY app/tools ./app/tools
# Never copy task definitions, reference answers, grading logic, or evaluation reports into the image.
COPY app/evaluation/candidate-driver.ts app/evaluation/evaluation-protocol.ts ./app/evaluation/
# Only the trusted supervisor runs as root. It drops groups and starts the worker as the host workspace owner.
# The runtime grants only SETUID/SETGID, drops all other capabilities, and forbids privilege escalation.
ENTRYPOINT []
CMD ["bun", "/agent/app/tools/sandbox-supervisor.ts"]
